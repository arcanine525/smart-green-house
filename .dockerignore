# Allowlist: no AGC, credentials, local plans or scratch files enter the image.
**
!docker/
!docker/**
!requirements*.lock
!pyproject.toml
!src/
!src/**
!tests/
!tests/**
!prototypes/
prototypes/*
!prototypes/dashboard/
prototypes/dashboard/*
!prototypes/dashboard/*.py
!prototypes/dashboard/template.html
!.streamlit/
!.streamlit/config.toml
**/__pycache__/
**/*.pyc
**/*.egg-info/
