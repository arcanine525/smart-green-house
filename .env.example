# Local example only. Copy to .env; never commit your .env or real credentials.
GREENHOUSE_DB_PASSWORD=change-me-local-demo
GREENHOUSE_DB_USER=greenhouse
GREENHOUSE_DB_NAME=greenhouse
GREENHOUSE_APP_PORT=8501

# Host paths: import/raw read only; processing output uses a separate named volume.
# Only snapshot/dataset-download get a writable raw mount; import stays read-only.
GREENHOUSE_IMPORT_PATH=./data/import
GREENHOUSE_RAW_PATH=./data/raw
GREENHOUSE_PREVIEW_PATH=./data/output/preview

# Resource caps (GiB/MiB suffixes accepted by Docker).
GREENHOUSE_JOB_CPUS=1.5
GREENHOUSE_JOB_MEMORY=2g
GREENHOUSE_STREAM_CPUS=1.0
GREENHOUSE_STREAM_MEMORY=1536m
GREENHOUSE_DRIVER_MEMORY=768m
GREENHOUSE_APP_CPUS=0.5
GREENHOUSE_APP_MEMORY=768m
# ui-test reuses the same app budget by default.
GREENHOUSE_UI_CPUS=0.5
GREENHOUSE_UI_MEMORY=768m
GREENHOUSE_DB_CPUS=0.5
GREENHOUSE_DB_MEMORY=512m
GREENHOUSE_BROKER_CPUS=0.1
GREENHOUSE_BROKER_MEMORY=128m
GREENHOUSE_SENSOR_CPUS=0.2
GREENHOUSE_SENSOR_MEMORY=128m

# ClickHouse candidate stack: docker compose -f compose.clickhouse.yaml ...
CH_DATABASE=greenhouse
CH_USER=greenhouse
CH_PASSWORD=change-me-clickhouse-local
GREENHOUSE_CH_APP_PORT=18581
GREENHOUSE_CH_CPUS=1
GREENHOUSE_CH_MEMORY=2g
