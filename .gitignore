# macOS metadata
.DS_Store
._*

# Temporary files and local scratch work
/tmp/
*.tmp
*.swp
*.swo
~$*

# Local environment variables and credentials
.env
.env.*
!.env.example
!.env.*.example
/.aws/

# Local tooling caches
/.playwright-mcp/
/.codegraph
/.omo/

# Videos ignored by default; accepted ClickHouse walkthroughs are allowed below.
*.mp4
*.webm
*.mov
/project-submit/demo-videos/*

# Python UI demo environment and caches
/.venv-ui/
__pycache__/
*.py[cod]

# Dataset archives, raw snapshots and generated outputs (fixtures stay tracked).
/data/
.pytest_cache/
.ruff_cache/
spark-warehouse/
metastore_db/
derby.log
checkpoints/
*.egg-info/
/build/
/dist/

# Reproducible application archive stays local; code and hash manifests are tracked.
/project-submit/*_application.zip

# Accepted ClickHouse review bundle: MP4/player/steps/screenshots/exports.
!/project-submit/demo-videos/clickhouse/
!/project-submit/demo-videos/clickhouse/**/*.mp4
/project-submit/demo-videos/clickhouse/**/recording/
/project-submit/demo-videos/clickhouse/**/*.webm
/project-submit/demo-videos/clickhouse/**/*.zip
/project-submit/demo-videos/clickhouse/**/*.cjs
/project-submit/demo-videos/clickhouse/**/*.log
